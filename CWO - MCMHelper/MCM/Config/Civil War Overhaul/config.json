{
  "$schema": "https://raw.githubusercontent.com/Exit-9B/MCM-Helper/main/docs/config.schema.json",
  "modName": "Civil War Overhaul",
  "displayName": "Civil War Overhaul",
  "minMcmVersion": 13,
  "pages": [
    {
      "pageDisplayName": "CWO Options",
      "content": [
        { "text": "Toggle Settings", "type": "header" },
        { "id": "bDisableNotifications:Main", "text": "Disable Notifications", "type": "toggle", "help": "Toggle helper notifications on or off.", "valueOptions": { "sourceType": "ModSettingBool", "defaultValue": false } },
        { "id": "bDisableBleedout:Main", "text": "Disable Player Bleedout", "type": "toggle", "help": "During a skirmish or siege, if your hitpoints drop to 0, you will instead faint and be whisked off to a nearby military camp. Check to disable this so you can just die and reload.", "valueOptions": { "sourceType": "ModSettingBool", "defaultValue": false } },
        { "id": "bDisableFriendlyFire:Main", "text": "Disable Friendly Fire", "type": "toggle", "help": "Ignores damage to fellow troops from the player. Only effective during sieges and select missions.", "valueOptions": { "sourceType": "ModSettingBool", "defaultValue": false } },
        { "type": "empty" },
        { "text": "Reinforcements", "type": "header" },
        { "id": "fCapitalReinforcements:Main", "text": "Capital Reinforcements Base", "type": "slider", "help": "Base reinforcements for minor capital sieges.", "valueOptions": { "min": 0, "max": 500, "step": 1, "formatString": "{0}", "sourceType": "ModSettingFloat", "defaultValue": 20 } },
        { "id": "fFortReinforcements:Main", "text": "Fort Reinforcements Base", "type": "slider", "help": "Base reinforcements for fort sieges.", "valueOptions": { "min": 0, "max": 300, "step": 1, "formatString": "{0}", "sourceType": "ModSettingFloat", "defaultValue": 15 } },
        { "id": "fSiegeReinforcements:Main", "text": "Siege Reinforcements Base", "type": "slider", "help": "Base reinforcements for major sieges.", "valueOptions": { "min": 0, "max": 300, "step": 1, "formatString": "{0}", "sourceType": "ModSettingFloat", "defaultValue": 25 } },
        { "id": "fGarrisonReinforcements:Main", "text": "Garrison Reinforcements Base", "type": "slider", "help": "Base reinforcements for garrison battles.", "valueOptions": { "min": 0, "max": 20, "step": 1, "formatString": "{0}", "sourceType": "ModSettingFloat", "defaultValue": 10 } },
        { "id": "fPlayerAttackerScaleMult:Main", "text": "Player Attacking Scale Mult", "type": "slider", "help": "Reinforcement multiplier for player's reinforcements when attacking.", "valueOptions": { "min": 0.2, "max": 2.0, "step": 0.1, "formatString": "{1}", "sourceType": "ModSettingFloat", "defaultValue": 0.8 } },
        { "id": "fPlayerDefenderScaleMult:Main", "text": "Player Defending Scale Mult", "type": "slider", "help": "Reinforcement multiplier for player's reinforcements when defending.", "valueOptions": { "min": 0.2, "max": 2.0, "step": 0.1, "formatString": "{1}", "sourceType": "ModSettingFloat", "defaultValue": 0.9 } },
        { "id": "fEnemyAttackerScaleMult:Main", "text": "Enemy Attacking Scale Mult", "type": "slider", "help": "Reinforcement multiplier for enemy's reinforcements when attacking.", "valueOptions": { "min": 0.2, "max": 2.0, "step": 0.1, "formatString": "{1}", "sourceType": "ModSettingFloat", "defaultValue": 1.1 } },
        { "id": "fEnemyDefenderScaleMult:Main", "text": "Enemy Defending Scale Mult", "type": "slider", "help": "Reinforcement multiplier for enemy's reinforcements when defending.", "valueOptions": { "min": 0.2, "max": 2.0, "step": 0.1, "formatString": "{1}", "sourceType": "ModSettingFloat", "defaultValue": 1.2 } },
        { "id": "fAdditionalSoldiers:Main", "text": "Additional soldiers per phase", "type": "slider", "help": "Tosses additional troops during sieges. They are not added in the beginning but should be thrown in as the siege progresses. Set to 0 to disable.", "valueOptions": { "min": 0, "max": 20, "step": 1, "formatString": "{0}", "sourceType": "ModSettingFloat", "defaultValue": 20 } },
        { "type": "empty" },
        { "text": "Gameplay Settings", "type": "header" },
        { "id": "iCampaignPhaseMax:Main", "text": "Campaign Phase Max", "type": "enum", "help": "Number of missions per hold (counting city siege). Setting to 1 will immediately go to city siege.", "valueOptions": { "options": ["1", "3", "5"], "sourceType": "ModSettingInt", "defaultValue": 1 } },
        { "id": "iPartyCrashersChance:Main", "text": "Party Crashers chance", "type": "slider", "help": "Chance for dragon attacks during major capital sieges.", "valueOptions": { "min": 0, "max": 100, "step": 1, "formatString": "{0}%", "sourceType": "ModSettingInt", "defaultValue": 0 } },
        { "id": "iBenedictArnoldChance:Main", "text": "Benedict Arnold Spies Chance", "type": "slider", "help": "Set the chance that a random guard or inconsequential NPC will become a spy for the other side. Set to 0 to disable.", "valueOptions": { "min": 0, "max": 100, "step": 1, "formatString": "{0}%", "sourceType": "ModSettingInt", "defaultValue": 4 } },
        { "id": "iSpanishInquisitionChance:Main", "text": "Spanish Inquisition Chance", "type": "slider", "help": "Sets the Spanish Inquisition chance. CWO will periodically poll and may start a defense quest if you are in a city your side controls.", "valueOptions": { "min": 0, "max": 100, "step": 1, "formatString": "{0}%", "sourceType": "ModSettingInt", "defaultValue": 2 } },
        { "id": "iCourierHoursMin:Main", "text": "Courier Hours Min", "type": "slider", "help": "The minimum number of hours to wait before getting delivered a message by the courier for the defense quest.", "valueOptions": { "min": 1, "max": 123, "step": 1, "formatString": "{0}", "sourceType": "ModSettingInt", "defaultValue": 24 } },
        { "id": "iCourierHoursMax:Main", "text": "Courier Hours Max", "type": "slider", "help": "The maximum number of hours to wait before getting delivered a message by the courier for the defense quest.", "valueOptions": { "min": 2, "max": 124, "step": 1, "formatString": "{0}", "sourceType": "ModSettingInt", "defaultValue": 124 } },
        { "id": "iDisguiseType:Main", "text": "Disguise Mechanic", "type": "enum", "help": "Default = Guards of contested holds will attack unless player dons a cuirass of the opposing faction. Realistic = Guards in contested holds will attack player only if player dons a cuirass of the player's faction.", "valueOptions": { "options": ["Default", "Realistic", "Disabled"], "sourceType": "ModSettingInt", "defaultValue": 0 } },
        { "type": "empty" },
        { "text": "Quick Actions", "type": "header" },
        { "text": "Pay Faction Crimes", "type": "text", "help": "If you inadvertantly hit your teammates and incurred a bounty, click here to clear it. Please exit the MCM once clicked.", "action": { "type": "CallFunction", "form": "Civil War Overhaul.esp|31AE6", "scriptName": "CWOMCMScript", "function": "OnPayCrimeFaction" } },
        { "text": "Stop Siege Music", "type": "text", "help": "Stops the siege music in case the CW siege music does not stop (Vanilla Bug). Close MCM after selecting.", "action": { "type": "CallFunction", "form": "Civil War Overhaul.esp|31AE6", "scriptName": "CWOMCMScript", "function": "OnStopMusic" } },
        { "text": "Fix Faction Aggression", "type": "text", "help": "This fixes an issue where CWO is installed on an existing game and the Player is set as an enemy to enemy towns. Ticking this will stop the disguise and set enemies to neutral. Please close the MCM after selecting.", "action": { "type": "CallFunction", "form": "Civil War Overhaul.esp|31AE6", "scriptName": "CWOMCMScript", "function": "OnFixFactionAggression" } },
        { "text": "Fix Whiterun Bridge", "type": "text", "help": "Fixes vanilla issue where the Whiterun Drawbridge is closed after the Whiterun Siege is over. Please close the MCM after selecting.", "action": { "type": "CallFunction", "form": "Civil War Overhaul.esp|31AE6", "scriptName": "CWOMCMScript", "function": "OnFixWhiterunBridge" } },
        { "text": "Win running siege", "type": "text", "help": "Wins a fort or major/minor capital siege already in progress. Use this if the siege did not finish for some reason. Please do not use this at the battle of Solitude or Windhelm. Please close MCM after selecting.", "action": { "type": "CallFunction", "form": "Civil War Overhaul.esp|31AE6", "scriptName": "CWOMCMScript", "function": "OnWinSiege" } },
        { "type": "empty" },
        { "text": "Campaign Actions", "type": "header" },
        { "id": "iStartSiegeHold:Main", "text": "Select Hold for Campaign", "type": "enum", "help": "Select a hold before clicking 'Force campaign here'.", "valueOptions": { "options": ["Markarth", "Morthal", "Whiterun", "Falkreath", "Dawnstar", "Winterhold", "Riften"], "sourceType": "PropertyValueInt", "sourceForm": "Civil War Overhaul.esp|31AE6", "scriptName": "CWOMCMScript", "propertyName": "iStartSiegeHold", "defaultValue": 0 } },
        { "text": "Force campaign here", "type": "text", "help": "Starts a campaign at the selected hold. Use this if you are not getting a quest from the general. Please close MCM after selecting.", "action": { "type": "CallFunction", "form": "Civil War Overhaul.esp|31AE6", "scriptName": "CWOMCMScript", "function": "OnStartSiege" } },
        { "id": "iWinHold:Main", "text": "Select Hold to Win", "type": "enum", "help": "Select a hold before clicking 'Win Hold here'.", "valueOptions": { "options": ["Markarth", "Morthal", "Whiterun", "Falkreath", "Dawnstar", "Winterhold", "Riften"], "sourceType": "PropertyValueInt", "sourceForm": "Civil War Overhaul.esp|31AE6", "scriptName": "CWOMCMScript", "propertyName": "iWinHold", "defaultValue": 0 } },
        { "text": "Win Hold here", "type": "text", "help": "Wins the selected hold. This should only be used if you own a hold but the Jarl nor troops left. Please close MCM after selecting.", "action": { "type": "CallFunction", "form": "Civil War Overhaul.esp|31AE6", "scriptName": "CWOMCMScript", "function": "OnWinHold" } },
        { "id": "iSwitchHold:Main", "text": "Select Hold to Switch", "type": "enum", "help": "Select a hold before clicking 'Switch sides here'.", "valueOptions": { "options": ["Markarth", "Morthal", "Whiterun", "Falkreath", "Dawnstar", "Winterhold", "Riften"], "sourceType": "PropertyValueInt", "sourceForm": "Civil War Overhaul.esp|31AE6", "scriptName": "CWOMCMScript", "propertyName": "iSwitchHold", "defaultValue": 0 } },
        { "text": "Switch sides here", "type": "text", "help": "Toggles the selected hold's ownership. This might not work for the hold currently in progress. Please close MCM after selecting.", "action": { "type": "CallFunction", "form": "Civil War Overhaul.esp|31AE6", "scriptName": "CWOMCMScript", "function": "OnSwitchHold" } },
        { "type": "empty" },
        { "text": "Win the War", "type": "header" },
        { "id": "iWinWarFaction:Main", "text": "Select Faction", "type": "enum", "help": "Select a faction before clicking 'Win the war'.", "valueOptions": { "options": ["Cancel", "Imperials", "Stormcloaks"], "sourceType": "PropertyValueInt", "sourceForm": "Civil War Overhaul.esp|31AE6", "scriptName": "CWOMCMScript", "propertyName": "iWinWarFaction", "defaultValue": 0 } },
        { "text": "Win the war", "type": "text", "help": "Automatically wins the war for the selected faction. This is obviously irreversible once done. Note that you will gain achievements and get a cool weapon like you were going through the questline. This process takes a LONG time (around 10 minutes). Also, make sure you select this away from any major cities. Please close MCM after selecting.", "action": { "type": "CallFunction", "form": "Civil War Overhaul.esp|31AE6", "scriptName": "CWOMCMScript", "function": "OnWinWar" } },
        { "type": "empty" },
        { "text": "Troubleshooting", "type": "header" },
        { "text": "Help get quests unstuck", "type": "text", "help": "Attempts to move a CWO quest along in case something is stuck. Please close MCM after selecting.", "action": { "type": "CallFunction", "form": "Civil War Overhaul.esp|31AE6", "scriptName": "CWOMCMScript", "function": "OnHelp" } },
        { "text": "Help get additional CW Missions unstuck", "type": "text", "help": "Attempts to move a CWO quest along in case something is stuck. This option pertains to Skirmish at X, Sabotage at X, and Can't Lead a Cow to Goldar. Please close MCM after selecting.", "action": { "type": "CallFunction", "form": "Civil War Overhaul.esp|31AE6", "scriptName": "CWOMCMScript", "function": "OnHelp2" } },
        { "text": "Uninstall CWO", "type": "text", "help": "EXPERIMENTAL!: Uninstalls CWO. Before selecting this option, make sure that you do a hard save and make sure that you are indoors. Make sure you use the console to remove any unique items that you received in CW Rewards. Make another hard save after uninstallation is complete. Once uninstallation has completed, remove CWO and any patches and restart the game. Please close MCM after selecting.", "action": { "type": "CallFunction", "form": "Civil War Overhaul.esp|31AE6", "scriptName": "CWOMCMScript", "function": "OnUninstall" } }
      ]
    },
    {
