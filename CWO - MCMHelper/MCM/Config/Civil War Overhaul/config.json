    {
      "pageDisplayName": "Compatibility",
      "content": [
        { "text": "Click the following options to DISABLE the following quests", "type": "header" },
        { "id": "bDisableCWMission01:Compatibility", "text": "Skirmish At X", "type": "toggle", "help": "Disables radiant quest. This mod adds small skirmishes to several towns. Use caution if using mods that drastically alters these locations.", "valueOptions": { "sourceType": "ModSettingBool", "defaultValue": false } },
        { "id": "bDisableCWMission02:Compatibility", "text": "Sabotage At X", "type": "toggle", "help": "Disables radiant quest. This does not affect any vanilla records but can cause problems if you install a mod that removes smelters, saw mills or windmills in several locations.", "valueOptions": { "sourceType": "ModSettingBool", "defaultValue": false } },
        { "id": "bDisableCWMission05:Compatibility", "text": "X's Last Battle", "type": "toggle", "help": "Disables radiant quest. This quest affects enemy commanders for each hold but does not alter any vanilla records.", "valueOptions": { "sourceType": "ModSettingBool", "defaultValue": false } },
        { "id": "bDisableCWMission06:Compatibility", "text": "Defector Collector", "type": "toggle", "help": "Disables radiant quest. This quest affects military camps.", "valueOptions": { "sourceType": "ModSettingBool", "defaultValue": false } },
        { "id": "bDisableCWMission08:Compatibility", "text": "Can't Lead a Cow to Guldar", "type": "toggle", "help": "Disables radiant quest. This should not conflict with anything since the events happen in the wilderness.", "valueOptions": { "sourceType": "ModSettingBool", "defaultValue": false } },
        { "id": "bDisableCWMission09:Compatibility", "text": "X Marks the Docs", "type": "toggle", "help": "Disables radiant quest. This quest makes small changes to invisible and unused markers in the Jarl buildings where the CW leader usually hangs out.", "valueOptions": { "sourceType": "ModSettingBool", "defaultValue": false } },
        { "id": "bDisableFortSiegeFort:Compatibility", "text": "Fort Siege Quest", "type": "toggle", "help": "Disables fort sieges radiant quest that is given in between city sieges.", "valueOptions": { "sourceType": "ModSettingBool", "defaultValue": false } },
        { "id": "bDisableSolitudeSiege:Compatibility", "text": "Solitude Exterior Siege", "type": "toggle", "help": "CWO restores siege objectives outside of Solitude. This can cause issues if you install mods that drastically changes Solitude's exterior. Select to revert to vanilla.", "valueOptions": { "sourceType": "ModSettingBool", "defaultValue": false } },
        { "id": "bDisableWindhelmSiege:Compatibility", "text": "Windhelm Exterior Siege", "type": "toggle", "help": "CWO restores siege objectives outside of Windhelm. This can cause issues if you install mods that drastically changes Windhelm's exterior. Select to revert to vanilla.", "valueOptions": { "sourceType": "ModSettingBool", "defaultValue": false } },
        { "id": "bDisableMinorCapitalStuff:Compatibility", "text": "Minor Capital Extra Obstacles/Clutter", "type": "toggle", "help": "CWO Adds barricades and extra clutter to minor capitals. Toggle on and off.", "valueOptions": { "sourceType": "ModSettingBool", "defaultValue": false } },
        { "id": "bDisableMarkarthSiege:Compatibility", "text": "Markarth Siege", "type": "toggle", "help": "Skips the new Siege at Markarth. Just takes The Reach after the quests and moves onto the next hold.", "valueOptions": { "sourceType": "ModSettingBool", "defaultValue": false } },
        { "id": "bDisableRiftenSiege:Compatibility", "text": "Riften Siege", "type": "toggle", "help": "Skips the new Siege at Riften. Just takes The Rift after the quests and moves onto the next hold.", "valueOptions": { "sourceType": "ModSettingBool", "defaultValue": false } },
        { "id": "bDisableMinorSieges:Compatibility", "text": "Minor Capital Sieges", "type": "toggle", "help": "Skips the new Sieges at Falkreath, Dawnstar, Morthal, and Winterhold.", "valueOptions": { "sourceType": "ModSettingBool", "defaultValue": false } }
      ]
    }
  ]
}